[alias]
    co = checkout
    ci = commit
    cm = commit -m
    br = branch
    st = status
    newBr = checkout -b
    ai = add -i

[core]
    editor = vim

# Identity and any machine-local settings live here, untracked. Git ignores
# this line silently if the file does not exist.
#
#   git config --file ~/.gitconfig.local user.name  "Your Name"
#   git config --file ~/.gitconfig.local user.email "you@example.com"
[include]
    path = ~/.gitconfig.local
